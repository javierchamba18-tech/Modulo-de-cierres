{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "atomo.theme.js",
              "components/actions/**",
              "components/data-display/**",
              "components/feedback/**",
              "components/forms/**",
              "components/foundations/**",
              "components/navigation/**",
              "components/overlays/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='AtomoProvider'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|theme|children|key|ref|className|style|children)$/]",
        "message": "<AtomoProvider> doesn't accept that prop. Declared props: tone, theme, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AtomoProvider'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|success)$/]",
        "message": "<AtomoProvider> tone must be one of 'primary' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|size|icon|iconRight|loading|disabled|block|iconOnly|htmlType|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, tone, size, icon, iconRight, loading, disabled, block, iconOnly, htmlType, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='htmlType'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> htmlType must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|extra|footer|padding|bordered|hoverable|bodyStyle|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: title, subtitle, extra, footer, padding, bordered, hoverable, bodyStyle, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|defaultChecked|indeterminate|disabled|onChange|size|children|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, defaultChecked, indeterminate, disabled, onChange, size, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|compact)$/]",
        "message": "<Checkbox> size must be one of 'default' | 'compact'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CollapseItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|description|icon|extra|disabled|children|key|ref|className|style|children)$/]",
        "message": "<CollapseItem> doesn't accept that prop. Declared props: key, label, description, icon, extra, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DatePicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|value|onChange|placeholder|size|status|disabled|allowClear|block|width|style|key|ref|className|style|children)$/]",
        "message": "<DatePicker> doesn't accept that prop. Declared props: mode, value, onChange, placeholder, size, status, disabled, allowClear, block, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DatePicker'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:date|datetime|range)$/]",
        "message": "<DatePicker> mode must be one of 'date' | 'datetime' | 'range'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DatePicker'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:default|error|warning)$/]",
        "message": "<DatePicker> status must be one of 'default' | 'error' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DropdownItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|icon|shortcut|danger|disabled|onClick|type|key|ref|className|style|children)$/]",
        "message": "<DropdownItem> doesn't accept that prop. Declared props: key, label, icon, shortcut, danger, disabled, onClick, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='DropdownItem'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:item|divider|group)$/]",
        "message": "<DropdownItem> type must be one of 'item' | 'divider' | 'group'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|title|description|action|compact|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: variant, icon, title, description, action, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:empty|search|filtered|error|permission)$/]",
        "message": "<EmptyState> variant must be one of 'empty' | 'search' | 'filtered' | 'error' | 'permission'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|required|help|error|warning|htmlFor|layout|labelWidth|extra|children|style|key|ref|className|style|children)$/]",
        "message": "<FormField> doesn't accept that prop. Declared props: label, required, help, error, warning, htmlFor, layout, labelWidth, extra, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormField'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:vertical|horizontal)$/]",
        "message": "<FormField> layout must be one of 'vertical' | 'horizontal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|status|variant|prefix|suffix|allowClear|type|addonBefore|addonAfter|block|inputStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: size, status, variant, prefix, suffix, allowClear, type, addonBefore, addonAfter, block, inputStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|delta|deltaLabel|trend|icon|tone|footer|loading|onClick|key|ref|className|style|children)$/]",
        "message": "<KpiCard> doesn't accept that prop. Declared props: label, value, unit, delta, deltaLabel, trend, icon, tone, footer, loading, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|success|warning|error|cyan|purple|neutral)$/]",
        "message": "<KpiCard> tone must be one of 'primary' | 'success' | 'warning' | 'error' | 'cyan' | 'purple' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Loader'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|label|inline|style|key|ref|className|style|children)$/]",
        "message": "<Loader> doesn't accept that prop. Declared props: variant, size, label, inline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Loader'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:spinner|skeleton|bar)$/]",
        "message": "<Loader> variant must be one of 'spinner' | 'skeleton' | 'bar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|onOk|title|description|kind|width|okText|cancelText|okTone|okLoading|footer|hideFooter|closable|inline|children|style|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, onClose, onOk, title, description, kind, width, okText, cancelText, okTone, okLoading, footer, hideFooter, closable, inline, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:default|confirm|warning|error|success|info)$/]",
        "message": "<Modal> kind must be one of 'default' | 'confirm' | 'warning' | 'error' | 'success' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute[name.name='okTone'] > Literal[value!=/^(?:primary|danger|success|neutral)$/]",
        "message": "<Modal> okTone must be one of 'primary' | 'danger' | 'success' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pagination'] > JSXAttribute > JSXIdentifier[name!=/^(?:current|pageSize|total|onChange|pageSizeOptions|showSizeChanger|showTotal|style|key|ref|className|style|children)$/]",
        "message": "<Pagination> doesn't accept that prop. Declared props: current, pageSize, total, onChange, pageSizeOptions, showSizeChanger, showTotal, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|disabled|value|onChange|children|style|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: checked, disabled, value, onChange, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|disabled|value|onChange|title|description|icon|extra|style|key|ref|className|style|children)$/]",
        "message": "<RadioCard> doesn't accept that prop. Declared props: checked, disabled, value, onChange, title, description, icon, extra, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|placeholder|value|defaultValue|onChange|onSearch|attachedButton|width|style|key|ref|className|style|children)$/]",
        "message": "<SearchInput> doesn't accept that prop. Declared props: size, placeholder, value, defaultValue, onChange, onSearch, attachedButton, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|disabled|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label, icon, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|icon|badge|children|href|disabled|danger|type|key|ref|className|style|children)$/]",
        "message": "<SidebarItem> doesn't accept that prop. Declared props: key, label, icon, badge, children, href, disabled, danger, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarItem'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:group|divider)$/]",
        "message": "<SidebarItem> type must be one of 'group' | 'divider'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|dataIndex|key|width|align|sorter|sortValue|filter|filtered|ellipsis|render|key|ref|className|style|children)$/]",
